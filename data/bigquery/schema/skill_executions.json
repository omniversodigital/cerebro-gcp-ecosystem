  {
    "name": "duration_ms",
    "type": "INTEGER",
    "mode": "NULLABLE",
    "description": "Execution duration in milliseconds"
  },
  {
    "name": "input_payload",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "JSON string of input parameters"
  },
  {
    "name": "output_payload",
    "type": "STRING",
    "mode": "NULLABLE",
    "description": "JSON string of execution result"
  },
  {
    "name": "error_message",
    "type": "STRING",
    "mode": "NULLABLE",
