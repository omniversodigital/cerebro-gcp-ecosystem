    "description": "Unique trace identifier for the execution"
  },
  {
    "name": "skill_name",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Name of the skill executed"
  },
  {
    "name": "command",
    "type": "STRING",
    "mode": "NULLABLE",
